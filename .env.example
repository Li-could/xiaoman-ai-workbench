# ============================================================
# 数据库连接配置模板 —— 复制为 .env 后按你的实际情况修改
#   Windows:  copy .env.example .env
#   或在 PyCharm 里右键 .env.example → Copy → Paste 后改名
#
# 所有业务数据都写入这个库：租户 / 用户 / 会话 / 消息 / 工单 /
# 质检 / 通知 / 素材 / 预警 / 工作流 / AI 配置 / 操作日志
# ============================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=xiaoman

# 连接与查询超时（毫秒）
DB_CONNECT_TIMEOUT=8000
DB_QUERY_TIMEOUT=60000

# MySQL 连不上时是否直接报错（1=报错退出，0=回落到 SQLite）
DB_STRICT=0

# ---------------- 大模型（可选，也可在「AI 设置」页里填）----------------
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxx

# ---------------- 平台真实接入（淘宝/天猫） ----------------
# PUBLIC_BASE_URL=https://your-domain.com
# 消息轮询间隔（毫秒），0 = 关闭
TMC_POLL_MS=60000
# 凭据加密密钥，留空自动生成 data/secret.key
# APP_SECRET=
