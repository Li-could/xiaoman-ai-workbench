<script>
    // 立即执行函数，确保代码能够立即运行
    (function() {
        if (window.__zkHeaderReady) return;
        window.__zkHeaderReady = true;
        // 移动端菜单切换
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        
        if (menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', function() {
                if (mobileMenu.classList.contains('hidden')) {
                    // 显示菜单时的动画
                    mobileMenu.classList.remove('hidden', 'opacity-0', 'translate-y-[-10px]');
                    mobileMenu.classList.add('opacity-100', 'translate-y-0');
                } else {
                    // 隐藏菜单时的动画
                    mobileMenu.classList.add('opacity-0', 'translate-y-[-10px]');
                    setTimeout(() => {
                        mobileMenu.classList.add('hidden');
                    }, 300);
                }
            });
        }
        
        // 导航栏滚动显示/隐藏功能
        const navbar = document.getElementById('navbar');
        let lastScrollY = 0;
        let scrollThreshold = 50; // 滚动阈值
        let hidden = false;
        
        // 简单直接的滚动监听
        window.addEventListener('scroll', function() {
            const currentScrollY = window.scrollY;
            
            // 导航栏样式变化
            if (currentScrollY > 50) {
                navbar.classList.add('py-2', 'shadow-md');
                navbar.classList.remove('py-3', 'shadow-sm');
            } else {
                navbar.classList.add('py-3', 'shadow-sm');
                navbar.classList.remove('py-2', 'shadow-md');
            }
            
            // 核心功能：向上滚动显示导航栏，向下滚动隐藏导航栏
            if (currentScrollY > 100) { // 只在页面滚动一定距离后才触发
                if (currentScrollY < lastScrollY - 10) { // 向上滚动超过10px
                    // 显示导航栏
                    navbar.style.transform = 'translateY(0)';
                    hidden = false;
                } else if (currentScrollY > lastScrollY + scrollThreshold && !hidden) { // 向下滚动超过阈值且当前未隐藏
                    // 隐藏导航栏
                    navbar.style.transform = 'translateY(-100%)';
                    hidden = true;
                }
            } else {
                // 页面顶部始终显示导航栏
                navbar.style.transform = 'translateY(0)';
            }
            
            lastScrollY = currentScrollY;
        });
        
        // 处理登录跳转，添加recommend参数
        window.handleLoginClick = function() {
            // 获取当前页面URL中的recommend参数值，确保在有锚点的情况下也能正确获取
            const urlParams = new URLSearchParams(window.location.search);
            const recommendValue = urlParams.get('recommend') || '';
            // 构建目标登录URL，只传递recommend字段和值
            const loginUrl = 'https://guanli.mshy.cn/?recommend=' + encodeURIComponent(recommendValue);
            // 执行跳转
            window.location.href = loginUrl;
        };
        
        // 处理下载页面跳转，添加recommend参数
        window.handleDownloadClick = function() {
            // 获取当前页面URL中的recommend参数值，确保在有锚点的情况下也能正确获取
            const urlParams = new URLSearchParams(window.location.search);
            const recommendValue = urlParams.get('recommend') || '';
            // 构建目标下载URL，添加recommend参数，使用绝对路径确保在任何页面都能正确跳转
            let downloadUrl = '/download.html';
            if (recommendValue) {
                downloadUrl += '?recommend=' + encodeURIComponent(recommendValue);
            }
            // 执行跳转
            window.location.href = downloadUrl;
        };
        
        // 处理锚点链接跳转，添加recommend参数
        window.handleAnchorClick = function(anchorId) {
            // 获取当前页面URL中的recommend参数值，确保在有锚点的情况下也能正确获取
            const urlParams = new URLSearchParams(window.location.search);
            const recommendValue = urlParams.get('recommend') || '';
            // 构建目标URL，添加recommend参数和锚点，使用绝对路径确保在任何页面都能正确跳转
            let targetUrl = '/index.html';
            if (recommendValue) {
                targetUrl += '?recommend=' + encodeURIComponent(recommendValue);
            }
            targetUrl += '#' + anchorId;
            // 执行跳转
            window.location.href = targetUrl;
        };
        
        // 确保window上的函数在动态加载后被正确定义
        if (!window.handleLoginClick || !window.handleDownloadClick || !window.handleAnchorClick) {
            // 如果函数未正确定义，重新定义它们
            window.handleLoginClick = window.handleLoginClick;
            window.handleDownloadClick = window.handleDownloadClick;
            window.handleAnchorClick = window.handleAnchorClick;
        }
    })();
</script>
    </div>

    <!-- 英雄区域 -->
    <section class="pt-32 pb-20 md:pt-40 md:pb-32 overflow-hidden relative">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-secondary/5 -z-10"></div>
        
        <!-- 装饰元素 -->
        <div class="absolute top-20 right-10 w-64 h-64 bg-primary/10 rounded-full blur-3xl -z-10"></div>
        <div class="absolute bottom-10 left-10 w-80 h-80 bg-secondary/10 rounded-full blur-3xl -z-10"></div>
        
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col lg:flex-row items-center">
                <div class="w-full lg:w-1/2 mb-12 lg:mb-0 ml-0 lg:ml-16">
                    <h1 class="text-[clamp(2rem,5vw,3.0rem)] font-bold leading-tight text-dark mb-6">
                        多平台<span class="text-primary">AI客服</span><span id="typing-text">聚合中枢</span><span id="cursor">|</span>
                    </h1>
                    <style>
                        #cursor {
                            color: #165DFF;
                            animation: blink 1s infinite;
                            font-weight: bold;
                        }
                        @keyframes blink {
                            0%, 100% { opacity: 1; }
                            50% { opacity: 0; }
                        }
                    </style>
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            // 打字效果函数
                            function typeEffect() {
                                const textElement = document.getElementById('typing-text');
                                const cursorElement = document.getElementById('cursor');
                                const words = ['聚合中枢', '解放双手'];
                                let wordIndex = 0;
                                let charIndex = 0;
                                let isDeleting = false;
                                let isEnd = false;
                                
                                function type() {
                                    // 获取当前要处理的单词
                                    const currentWord = words[wordIndex];
                                    
                                    // 控制光标闪烁
                                    cursorElement.style.opacity = cursorElement.style.opacity === '0' ? '1' : '0';
                                    
                                    if (!isDeleting && charIndex < currentWord.length) {
                                        // 打字状态
                                        textElement.textContent = currentWord.substring(0, charIndex + 1);
                                        charIndex++;
                                        setTimeout(type, 150); // 打字速度
                                    } else if (isDeleting && charIndex > 0) {
                                        // 回退状态
                                        textElement.textContent = currentWord.substring(0, charIndex - 1);
                                        charIndex--;
                                        setTimeout(type, 80); // 回退速度
                                    } else if (!isDeleting && charIndex === currentWord.length) {
                                        // 完成当前单词打字
                                        isEnd = true;
                                        setTimeout(() => {
                                            isDeleting = true;
                                            type();
                                        }, 1500); // 停留时间
                                    } else {
                                        // 完成回退，切换到下一个单词
                                        isDeleting = false;
                                        isEnd = false;
                                        wordIndex = (wordIndex + 1) % words.length;
                                        setTimeout(type, 500);
                                    }
                                }
                                
                                // 开始打字效果
                                type();
                            }
                            
                            // 调用打字效果函数
                            typeEffect();
                            });
                        </script>
                    <p class="text-[clamp(1rem,2vw,1.25rem)] text-gray-600 mb-8 max-w-xl">
                        1个窗口管理所有店铺，AI替你处理80%的咨询，让你专注于真正重要的事情。
                    </p>
                    
                    <!-- 数据指标 -->
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-10">
                        <div class="bg-white p-4 rounded-xl shadow-sm">
                            <div class="text-3xl font-bold text-primary mb-1">90%</div>
