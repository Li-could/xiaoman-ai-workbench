                <!-- AI客服组件 -->
                <div class="w-full lg:w-[57.5%] relative">
                    <!-- 蒙版背景 -->
                    <div class="absolute inset-0 bg-white/10 backdrop-blur-sm rounded-xl -z-10"></div>
                    
                    <div class="bg-white/50 rounded-xl shadow-lg overflow-hidden transform transition-all duration-500 hover:scale-[1.02] max-w-lg mx-auto lg:ml-auto lg:mr-8">
                        <!-- 头部 -->
                        <div class="bg-primary/30 text-white p-4 flex items-center justify-between">
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
                                    <i class="fa fa-comments text-xl"></i>
                                </div>
                                <div>
                                    <h2 class="font-semibold">在线客服</h2>
                                    <p class="text-xs text-white/80" id="chat-status">正在处理12条咨询</p>
                                </div>
                            </div>
                            <div class="flex space-x-3">
                                <div class="flex items-center">
                                    <span class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></span>
                                    <span class="text-xs">在线</span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- 对话内容区域 -->
                        <div id="main-chat-messages" class="p-4 space-y-4 h-[400px] overflow-y-auto bg-white/30">
                            <!-- 消息将通过JS动态添加 -->
                        </div>
                        
                        <!-- 输入区域 -->
                        <div class="border-t border-gray-200 p-4 bg-gray-50">
                            <div class="flex items-center space-x-3">
                                <input type="text" placeholder="输入消息..." class="flex-grow py-3 px-5 rounded-full bg-white/50 border border-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 text-base">
                                <button class="w-12 h-12 rounded-full bg-primary/90 flex items-center justify-center text-white hover:bg-primary transition-colors">
                                    <i class="fa fa-paper-plane"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 浮动统计卡片 -->
                    <div class="absolute -bottom-6 -right-6 bg-white p-4 rounded-lg shadow-lg animate-pulse-slow hidden md:block z-10">
                        <div class="text-sm font-medium text-green-600">
                            <i class="fa fa-line-chart mr-1"></i> 转化率提升33%
                        </div>
                    </div>
                    
                    <!-- 背景效果 -->
                    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full h-full bg-gradient-to-br from-primary/20 to-secondary/20 rounded-full blur-3xl -z-10"></div>
                    
                    <script>
                        // AI客服对话脚本
                        document.addEventListener('DOMContentLoaded', function() {
                            // 对话数据
                            const messages = [
                                { side: 'left', text: '你好在吗', sender: '买家' },
                                { side: 'right', text: '亲亲，我在哦，请问有什么可以帮您', sender: 'AI客服' },
                                { side: 'left', text: '身高176 适合什么尺码', sender: '买家' },
                                { side: 'right', text: '亲，这款是修身款哦，建议您穿着XXL码', sender: 'AI客服' },
                                { side: 'left', text: '几天发货？', sender: '买家' },
                                { side: 'right', text: '亲亲，商品为现货哦，会尽快打包发货哦', sender: 'AI客服' },
                                { type: 'timestamp', text: '2天后' },
                                { side: 'left', text: '什么时候能到？', sender: '买家' },
                                { side: 'right', text: '亲爱的，目前快递正在运送中哦，目前显示已经到达郑州中转，预计很快就会送到哦', sender: 'AI客服' }
                            ];

                            const chatContainer = document.getElementById('main-chat-messages');
                            const statusText = document.getElementById('chat-status');
                            
                            // 主聊天窗口样式
                            const chatStyles = `
                                .chat-message {
                                    animation: fadeIn 0.5s ease-out;
                                }
                                .chat-message-left {
                                    display: flex;
                                    align-items: flex-start;
                                    margin-bottom: 12px;
                                }
                                .chat-message-right {
                                    display: flex;
                                    align-items: flex-start;
                                    justify-content: flex-end;
                                    margin-bottom: 12px;
                                }
                                .chat-avatar {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 50%;
                                    display: flex;
                                    align-items: center;
                                    justify-content: center;
                                    margin-right: 8px;
                                    flex-shrink: 0;
                                    font-size: 12px;
                                }
                                .chat-avatar-right {
                                    order: 2;
                                    margin-right: 0;
                                    margin-left: 8px;
                                }
                                .chat-bubble {
                                    max-width: 80%;
                                    padding: 10px 14px;
                                    border-radius: 16px;
                                    font-size: 13px;
                                    line-height: 1.4;
                                    word-wrap: break-word;
                                }
                                .chat-bubble-left {
                                    background-color: rgba(245, 245, 245, 0.7);
                                    color: #555;
                                    border-bottom-left-radius: 4px;
                                }
                                .chat-bubble-right {
                                    background-color: rgba(22, 93, 255, 0.7);
                                    color: white;
                                    border-bottom-right-radius: 4px;
                                }
                                .chat-sender {
                                    font-size: 11px;
                                    color: #999;
                                    margin-bottom: 4px;
                                    margin-left: 42px;
                                }
                                .chat-sender-right {
                                    text-align: right;
                                    margin-left: 0;
                                    margin-right: 42px;
                                }
                                .chat-timestamp {
                                    text-align: center;
                                    margin: 12px 0;
                                }
                                .chat-timestamp span {
                                    background-color: rgba(0,0,0,0.04);
                                    color: #999;
                                    padding: 3px 10px;
                                    border-radius: 10px;
                                    font-size: 11px;
                                }
                                @keyframes fadeIn {
                                    from {
                                        opacity: 0;
                                        transform: translateY(6px);
                                    }
                                    to {
                                        opacity: 1;
                                        transform: translateY(0);
                                    }
                                }
                                /* 美化滚动条 */
                                #main-chat-messages::-webkit-scrollbar {
                                    width: 4px;
                                }
                                #main-chat-messages::-webkit-scrollbar-track {
                                    background: rgba(241, 245, 249, 0.3);
                                    border-radius: 8px;
                                }
                                #main-chat-messages::-webkit-scrollbar-thumb {
                                    background-color: rgba(22, 93, 255, 0.2);
                                    border-radius: 8px;
                                    transition: background-color 0.3s ease;
                                }
                                #main-chat-messages::-webkit-scrollbar-thumb:hover {
                                    background-color: rgba(22, 93, 255, 0.3);
                                }
                            `;

                            // 添加样式
                            const styleElement = document.createElement('style');
                            styleElement.textContent = chatStyles;
                            document.head.appendChild(styleElement);
                            
                            // 添加时间戳
                            function addTimestamp(text) {
                                const timestampEl = document.createElement('div');
                                timestampEl.className = 'chat-timestamp';
                                timestampEl.innerHTML = `<span>${text}</span>`;
                                chatContainer.appendChild(timestampEl);
                            }
                            
                            // 添加消息到聊天窗口
                            function addMessage(message, index) {
                                return new Promise((resolve) => {
                                    setTimeout(() => {
                                        // 更新状态文本
                                        if (message.side === 'right') {
                                            statusText.textContent = '正在输入中...';
                                        } else if (message.side === 'left') {
                                            statusText.textContent = '对方正在输入...';
                                        }
                                        
                                        if (message.type === 'timestamp') {
                                            // 添加时间分隔线
                                            addTimestamp(message.text);
                                        } else {
                                            // 创建发送者标签
                                            const senderEl = document.createElement('div');
                                            senderEl.className = `chat-sender ${message.side === 'right' ? 'chat-sender-right' : ''}`;
                                            senderEl.textContent = message.sender;
                                            chatContainer.appendChild(senderEl);
                                            
                                            // 创建消息元素
                                            const messageEl = document.createElement('div');
                                            messageEl.className = `chat-message chat-message-${message.side}`;
                                            
                                            const avatarClass = message.side === 'left' 
                                                ? 'bg-gray-200 text-gray-700' 
                                                : 'bg-primary/80 text-white';
                                            
                                            const bubbleClass = message.side === 'left' 
                                                ? 'chat-bubble-left' 
                                                : 'chat-bubble-right';
                                            
                                            messageEl.innerHTML = `
                                                <div class="chat-avatar ${avatarClass} ${message.side === 'right' ? 'chat-avatar-right' : ''}">
                                                    <i class="fa fa-user"></i>
                                                </div>
                                                <div class="chat-bubble ${bubbleClass}">
                                                    ${message.text}
                                                </div>
                                            `;
                                            
                                            chatContainer.appendChild(messageEl);
                                        }
                                        
                                        // 滚动到底部
                                        chatContainer.scrollTop = chatContainer.scrollHeight;
                                        
                                        resolve();
                                    }, 2000 + index * 800); // 动态延迟
                                });
                            }
                            
                            // 初始化聊天
                            async function initChat() {
                                // 清空现有消息
                                chatContainer.innerHTML = '';
                                
                                // 逐条添加消息
                                for (let i = 0; i < messages.length; i++) {
                                    await addMessage(messages[i], i);
                                }
                                
                                // 所有消息显示完毕后，恢复状态并准备重新开始
                                statusText.textContent = '正在处理12条咨询';
                                
                                setTimeout(() => {
                                    initChat();
                                }, 3000);
                            }
                            
                            // 页面加载完成后初始化
                            initChat();
                        });
                    </script>
                </div>
            </div>
        </div>
    </section>
    
